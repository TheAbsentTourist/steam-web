#!/bin/sh
# Optional terminal helper. Cursor spawn is mcp.json: node ./server.mjs
# (cwd ${PLUGIN_ROOT}). Grok Bot already runs node …/server.mjs.
case $0 in
  */*) dir=${0%/*} ;;
  *) dir=. ;;
esac
root=$(CDPATH= cd -- "$dir/.." && pwd) || exit 1
server="$root/server.mjs"

if [ ! -f "$server" ]; then
  printf '%s\n' "steam-web: missing $server" >&2
  exit 1
fi

exec node "$server" "$@"
