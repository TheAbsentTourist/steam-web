{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "steam-web": {
      "type": "stdio",
      "command": "${PLUGIN_ROOT}/bin/steam-web-mcp",
      "args": [],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "STEAM_WEB_API_KEY": "${STEAM_WEB_API_KEY}",
        "STEAM_ID": "${STEAM_ID}"
      }
    }
  }
}
