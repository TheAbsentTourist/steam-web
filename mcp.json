{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "steam-web": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "call",
        "${PLUGIN_ROOT}\\scripts\\run-mcp.cmd"
      ],
      "env": {
        "STEAM_WEB_API_KEY": "${STEAM_WEB_API_KEY}",
        "STEAM_ID": "${STEAM_ID}"
      }
    }
  }
}
