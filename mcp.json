{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "steam-web": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "github:TheAbsentTourist/steam-web"],
      "env": {
        "STEAM_WEB_API_KEY": "${STEAM_WEB_API_KEY}",
        "STEAM_ID": "${STEAM_ID}"
      }
    }
  }
}
